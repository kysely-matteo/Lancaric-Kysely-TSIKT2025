<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sk.front.front.controller.AnalyticsController"
      spacing="20"
      style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <!-- Header -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label fx:id="groupNameLabel" text="Štatistiky skupiny"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label fx:id="monthLabel" style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Obnoviť" onAction="#handleRefresh"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
        <Button text="← Späť" onAction="#handleBack"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

    <!-- Quick Stats -->
    <GridPane hgap="15" vgap="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10;">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
        </columnConstraints>

        <!-- Column 0 -->
        <VBox alignment="CENTER" GridPane.columnIndex="0">
            <Label text="Celkovo úloh" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="totalTasksLabel" text="0"
                   style="-fx-font-size: 32px; -fx-text-fill: #2196F3; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Column 1 -->
        <VBox alignment="CENTER" GridPane.columnIndex="1">
            <Label text="Dokončené" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="completedTasksLabel" text="0"
                   style="-fx-font-size: 32px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Column 2 -->
        <VBox alignment="CENTER" GridPane.columnIndex="2">
            <Label text="Úspešnosť" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="completionRateLabel" text="0%"
                   style="-fx-font-size: 32px; -fx-text-fill: #FF9800; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Column 3 -->
        <VBox alignment="CENTER" GridPane.columnIndex="3">
            <Label text="Materiály" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="totalResourcesLabel" text="0"
                   style="-fx-font-size: 32px; -fx-text-fill: #9C27B0; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Column 4 -->
        <VBox alignment="CENTER" GridPane.columnIndex="4">
            <Label text="Priem. čas" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label fx:id="avgCompletionTimeLabel" text="0 hod"
                   style="-fx-font-size: 24px; -fx-text-fill: #F44336; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Column 5 - Placeholder for future stats -->
        <VBox alignment="CENTER" GridPane.columnIndex="5">
            <Label text="Aktívnych členov" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label text="-"
                   style="-fx-font-size: 32px; -fx-text-fill: #00BCD4; -fx-font-weight: bold;"/>
        </VBox>
    </GridPane>

    <!-- Charts Section -->
    <HBox spacing="15" style="-fx-padding: 0 0 20 0;">
        <!-- Task Status Chart -->
        <VBox fx:id="taskChartContainer"
              style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;"
              prefWidth="320" prefHeight="300">
            <Text text="Stav úloh" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
        </VBox>

        <!-- Resource Type Chart -->
        <VBox fx:id="resourceChartContainer"
              style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;"
              prefWidth="320" prefHeight="300">
            <Text text="Typy materiálov" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
        </VBox>

        <!-- Member Activity Chart -->
        <VBox fx:id="memberChartContainer"
              style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;"
              prefWidth="320" prefHeight="300">
            <Text text="Top členovia" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
        </VBox>
    </HBox>

    <!-- Member Activity Table -->
    <VBox style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;">
        <Text text="Aktivita členov" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>

        <TableView fx:id="memberActivityTable" prefHeight="250">
            <columns>
                <TableColumn fx:id="memberNameColumn" text="Meno" prefWidth="150"/>
                <TableColumn fx:id="memberRoleColumn" text="Rola" prefWidth="80"/>
                <TableColumn fx:id="tasksCreatedColumn" text="Vytvorené úlohy" prefWidth="120"/>
                <TableColumn fx:id="tasksCompletedColumn" text="Dokončené úlohy" prefWidth="120"/>
                <TableColumn fx:id="resourcesColumn" text="Materiály" prefWidth="80"/>
                <TableColumn fx:id="activityScoreColumn" text="Skóre" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

</VBox>