<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sk.front.front.controller.LoginController"
      stylesheets="@../styles/main.css">

    <padding><Insets top="50" bottom="50" left="100" right="100"/></padding>

    <Text text="Collaborative Study Platform" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-pref-width: 300;">
        <Label text="Email:"/>
        <TextField fx:id="emailField" promptText="Zadajte email"/>

        <Label text="Heslo:"/>
        <PasswordField fx:id="passwordField" promptText="Zadajte heslo"/>

        <Button text="Prihlásiť sa" onAction="#handleLogin"
                style="-fx-pref-width: 300; -fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Registrovať sa" onAction="#handleRegister"
                style="-fx-pref-width: 300; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="← Späť" onAction="#handleBackToWelcome"
                style="-fx-pref-width: 300; -fx-background-color: #757575; -fx-text-fill: white;"/>
    </VBox>
</VBox>