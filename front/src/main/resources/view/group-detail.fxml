<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sk.front.front.controller.GroupDetailController"
      spacing="20"
      style="-fx-padding: 20;">

    <!-- Header -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <Button text="← Späť na Dashboard" onAction="#handleBackToDashboard"
                style="-fx-background-color: #757575; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Detail skupiny" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Group Basic Info -->
    <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="groupNameLabel" text="Názov skupiny" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="memberCountLabel" text="Počet členov: 0" style="-fx-font-size: 14; -fx-text-fill: #666;"/>
        </HBox>

        <Label fx:id="groupDescriptionLabel" text="Popis skupiny" style="-fx-font-size: 14; -fx-text-fill: #333;"/>

        <TextArea fx:id="groupInfoArea" prefHeight="80" editable="false"
                  style="-fx-background-color: #f9f9f9; -fx-border-color: #eee;"/>
    </VBox>

    <!-- Quick Actions -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Pridať člena" onAction="#handleAddMember"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Vytvoriť úlohu" onAction="#handleCreateTask"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="📁 Nahrať súbor" onAction="#handleUploadFile"
                style="-fx-background-color: #607D8B; -fx-text-fill: white;"/>
        <Button text="🔗 Pridať odkaz" onAction="#handleAddLink"
                style="-fx-background-color: #795548; -fx-text-fill: white;"/>
        <Button text="⟳ Obnoviť všetko" onAction="#handleRefreshAll"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
    </HBox>

    <!-- Main Content - Split between Members, Tasks and Resources -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Members Section -->
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-pref-width: 300;">
            <Text text="👥 Členovia skupiny" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <ListView fx:id="membersListView" prefHeight="350"/>
        </VBox>

        <!-- Tasks Section -->
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;" HBox.hgrow="ALWAYS">
            <Text text="📋 Úlohy skupiny" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <!-- Task Filters -->
            <HBox fx:id="taskFilterButtons" spacing="5" alignment="CENTER_LEFT"/>

            <!-- Tasks List -->
            <ListView fx:id="tasksListView" prefHeight="300" VBox.vgrow="ALWAYS"/>

            <!-- Task Actions -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="✏️ Zmeniť stav" onAction="#handleUpdateTaskStatus"
                        style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 12;"/>
                <Button text="🗑️ Zmazať úlohu" onAction="#handleDeleteTask"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 12;"/>
            </HBox>
        </VBox>

        <!-- Resources Section -->
        <VBox fx:id="resourcesSection" spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-pref-width: 400;">
            <Text text="📚 Študijné materiály" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <!-- Resource Actions -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="uploadFileButton" text="📁 Súbor" onAction="#handleUploadFile"
                        style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 12;"/>
                <Button fx:id="addLinkButton" text="🔗 Odkaz" onAction="#handleAddLink"
                        style="-fx-background-color: #795548; -fx-text-fill: white; -fx-font-size: 12;"/>
                <Button fx:id="refreshResourcesButton" text="⟳" onAction="#handleRefreshResources"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 12;"/>
            </HBox>

            <!-- Resources Table -->
            <TableView fx:id="resourcesTableView" prefHeight="300" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="resourceNameColumn" text="Názov" prefWidth="120"/>
                    <TableColumn fx:id="resourceTypeColumn" text="Typ" prefWidth="60"/>
                    <TableColumn fx:id="resourceUploaderColumn" text="Nahral" prefWidth="80"/>
                    <TableColumn fx:id="resourceDateColumn" text="Dátum" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Resource Info -->
            <Label text="Klikni pravým pre možnosti" style="-fx-font-size: 11; -fx-text-fill: #666; -fx-font-style: italic;"/>
        </VBox>
    </HBox>
</VBox>