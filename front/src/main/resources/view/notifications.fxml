<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sk.front.front.controller.NotificationsController"
      spacing="10"
      style="-fx-background-color: #f5f5f5;"
      prefHeight="500.0" prefWidth="400.0">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Hlavička -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="🔔 Notifikácie" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Button text="Zmazať všetko" fx:id="clearButton" onAction="#handleClearAll"
                style="-fx-background-color: #ff6b6b; -fx-text-fill: white;"/>
    </HBox>

    <!-- Zoznam notifikácií -->
    <ListView fx:id="notificationListView" VBox.vgrow="ALWAYS"/>

    <!-- Status bar -->
    <Label fx:id="statusLabel" text="0 notifikácií" style="-fx-text-fill: #666;"/>
</VBox>